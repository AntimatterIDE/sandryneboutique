# ============================================================================
# Sandryne Boutique — environment variables
# Copy to .env.local for development. Add every variable to Vercel
# (Project > Settings > Environment Variables) for deployment.
# Never put real secrets in this file.
# ============================================================================

# --- Supabase (Dashboard > Settings > API) ----------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Heartland / Global Payments (Portico) ----------------------------------
# Sandbox: pkapi_cert_... / skapi_cert_...  Production: pkapi_prod_... / skapi_prod_...
NEXT_PUBLIC_HEARTLAND_PUBLIC_KEY=pkapi_cert_your_key
HEARTLAND_SECRET_KEY=skapi_cert_your_key

# Assigned by Heartland for Sandryne Boutique certification. Required on every Portico request.
HEARTLAND_DEVELOPER_ID=002914
HEARTLAND_VERSION_NUMBER=6401

# hCaptcha (checkout bot protection). Get keys at https://www.hcaptcha.com/
# Local test pair: site 10000000-ffff-ffff-ffff-000000000001 / secret 0x0000000000000000000000000000000000000000
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=your_hcaptcha_site_key
HCAPTCHA_SECRET_KEY=your_hcaptcha_secret_key

# --- Heartland Retail POS (inventory source of truth) ------------------------
# Base URL: https://{subdomain}.retail.heartland.us/api
HEARTLAND_RETAIL_SUBDOMAIN=yourstore
HEARTLAND_RETAIL_API_TOKEN=your_retail_api_token
HEARTLAND_RETAIL_STATION_ID=0
HEARTLAND_RETAIL_LOCATION_ID=0
HEARTLAND_RETAIL_WEB_PAYMENT_TYPE=0
# Optional. Used when a refund must add qty back with an inventory adjustment.
HEARTLAND_RETAIL_ADJUSTMENT_REASON_ID=

# Protects /api/cron/sync-heartland-inventory (Authorization: Bearer …).
# Generate with: openssl rand -hex 32
CRON_SECRET=generate_a_long_random_string

# --- React Bits Pro ----------------------------------------------------------
REACTBITS_LICENSE_KEY=your-react-bits-license-key

# --- UPS (checkout Ground rates + Admin labels) --------------------------------
# Create an app at https://developer.ups.com and add Rating + Shipping products.
# Production credentials bill your existing UPS shipper account.
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT_NUMBER=
# Use "test" against wwwcie.ups.com while you verify the app, then "production".
# Test/CIE returns published list rates, not the boutique's discounted account rates.
UPS_ENV=production

# --- Email (Resend) ----------------------------------------------------------
# Create an API key at https://resend.com and verify sandryneboutique.com.
# Until the domain is verified, Resend can only send to your own login email.
RESEND_API_KEY=
# Optional override. Default: Sandryne Boutique <info@sandryneboutique.com>
EMAIL_FROM=Sandryne Boutique <info@sandryneboutique.com>

# --- Site --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Demo / development ------------------------------------------------------
# Set to false for real authentication in production.
AUTH_BYPASS=false
